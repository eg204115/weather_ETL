{
  "name": "weather-medallion-pipeline",
  "tags": {
    "project": "weather-etl-databricks"
  },
  "job_clusters": [
    {
      "job_cluster_key": "weather_pipeline_cluster",
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "num_workers": 1,
        "azure_attributes": {
          "availability": "ON_DEMAND_AZURE"
        },
        "spark_conf": {
          "spark.databricks.delta.preview.enabled": "true"
        }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "bronze_ingest",
      "job_cluster_key": "weather_pipeline_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/weather-pipeline/notebooks/01_bronze_ingest",
        "base_parameters": {
          "storage_account": "yourstorageaccount",
          "container": "weather",
          "catalog": "hive_metastore",
          "schema": "weather_pipeline"
        }
      }
    },
    {
      "task_key": "silver_transform",
      "depends_on": [
        { "task_key": "bronze_ingest" }
      ],
      "job_cluster_key": "weather_pipeline_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/weather-pipeline/notebooks/02_silver_transform",
        "base_parameters": {
          "storage_account": "yourstorageaccount",
          "container": "weather",
          "catalog": "hive_metastore",
          "schema": "weather_pipeline"
        }
      }
    },
    {
      "task_key": "gold_aggregate",
      "depends_on": [
        { "task_key": "silver_transform" }
      ],
      "job_cluster_key": "weather_pipeline_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/weather-pipeline/notebooks/03_gold_aggregate",
        "base_parameters": {
          "storage_account": "yourstorageaccount",
          "container": "weather",
          "catalog": "hive_metastore",
          "schema": "weather_pipeline"
        }
      }
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 * * * ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  },
  "email_notifications": {
    "on_failure": []
  },
  "max_concurrent_runs": 1
}
